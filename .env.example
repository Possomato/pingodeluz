# ─── Supabase ────────────────────────────────────────────────
# Painel do projeto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ignora RLS. Só é lida no servidor — nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site ────────────────────────────────────────────────────
# Base das URLs de retorno do pagamento, do webhook e do sitemap.
# Em desenvolvimento: http://localhost:3000
# Em produção: https://pingodeluz.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dados legais exibidos no rodapé (obrigatórios para vender online).
# Sem eles o rodapé mostra só "PINGO DE LUZ".
NEXT_PUBLIC_STORE_LEGAL_NAME=
NEXT_PUBLIC_STORE_CNPJ=

# ─── Pagamentos ──────────────────────────────────────────────
# Qual adaptador usar. Ver src/lib/payments/README.md.
PAYMENT_PROVIDER=mercadopago

# Mercado Pago → Suas integrações → Credenciais.
# Em desenvolvimento, use as credenciais de um USUÁRIO DE TESTE (vendedor).
MERCADOPAGO_ACCESS_TOKEN=
# Chave pública da mesma aplicação (Credenciais → Public Key). Vai para o
# navegador de propósito: só serve para gerar o token do cartão nos campos
# seguros. Sem ela, a opção "cartão" fica indisponível; Pix e boleto seguem.
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
# Mercado Pago → Webhooks → Assinatura secreta.
# Sem ela, todo webhook é recusado com 401.
MERCADOPAGO_WEBHOOK_SECRET=

# Protege /api/cron/*. Gere um valor longo e aleatório; a Vercel o envia
# como "Authorization: Bearer <valor>" ao disparar o cron.
CRON_SECRET=

# ─── Integrações opcionais ───────────────────────────────────
# Feed do Instagram na home. Sem token, a seção simplesmente não aparece.
INSTAGRAM_ACCESS_TOKEN=
