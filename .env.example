# ─── Supabase ────────────────────────────────────────────────
# Painel do projeto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ignora RLS. Só é lida no servidor — nunca prefixe com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Site ────────────────────────────────────────────────────
# Base das URLs de retorno do pagamento, do webhook e do sitemap.
# Em desenvolvimento: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Pagamentos ──────────────────────────────────────────────
# Qual adaptador usar. Ver src/lib/payments/README.md.
PAYMENT_PROVIDER=mercadopago

# Mercado Pago → Suas integrações → Credenciais.
# Use as credenciais de TESTE em desenvolvimento.
MERCADOPAGO_ACCESS_TOKEN=
# Mercado Pago → Webhooks → Assinatura secreta.
# Sem ela, todo webhook é recusado com 401.
MERCADOPAGO_WEBHOOK_SECRET=

# ─── Integrações opcionais ───────────────────────────────────
# Feed do Instagram na home. Sem token, a seção simplesmente não aparece.
INSTAGRAM_ACCESS_TOKEN=
